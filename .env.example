# ---------------------------------------------------------------------------
# CODEX TECH — environment variables
# Copy this file to `.env.local` and fill in the values.
# The site builds and runs without them; CMS-driven sections simply fall back
# to placeholder content until a Sanity project is connected.
# ---------------------------------------------------------------------------

# --- Public site -----------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang
# alternates, Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact ---------------------------------------------------------------
# All optional. The email address falls back to the one in
# `src/content/contact.ts`; phone and WhatsApp have no default and an unset
# channel is hidden rather than rendered empty, so the site never shows a number
# nobody is answering. Site Settings in the CMS overrides all three.
# Set this only to use an address other than the one in the code.
NEXT_PUBLIC_CONTACT_EMAIL=
# International format, e.g. +966500000000
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# --- Contact form delivery -------------------------------------------------
# Enquiries are sent through Resend (https://resend.com). Without a key the
# form reports a delivery failure and points the visitor at the email address.
RESEND_API_KEY=
# Where enquiries land. Defaults to the public contact address.
CONTACT_RECIPIENT=
# The `From` address. Must be on a domain verified with Resend.
CONTACT_SENDER=

# --- Sanity (public) -------------------------------------------------------
# Found at https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin to a date; never use "vX" in production.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27

# --- Sanity (server only) --------------------------------------------------
# Viewer token with "read" access to drafts. Required only for draft preview.
# Never expose this to the browser.
SANITY_API_READ_TOKEN=
# Editor token used only by `npm run sanity:seed` to fill the dashboard once.
SANITY_API_WRITE_TOKEN=

# --- Webhooks --------------------------------------------------------------
# Shared secret sent by the Sanity webhook to POST /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Secret appended to the preview URL: /api/draft/enable?secret=...&slug=...
SANITY_PREVIEW_SECRET=
